{
  // Type-checks the shipped JavaScript (no build output): the server, the
  // installer and the scripts. Tests are left to the test run.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "scripts/**/*.mjs", "bin/**/*.mjs"]
}
