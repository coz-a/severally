{
  "name": "severally-mcp",
  "version": "2.4.2",
  "description": "A plugin that lets your AI agent ask other coding agents for independent opinions, returned separately.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "coz.a (https://github.com/coz-a)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coz-a/severally.git"
  },
  "homepage": "https://github.com/coz-a/severally#readme",
  "bugs": {
    "url": "https://github.com/coz-a/severally/issues"
  },
  "private": false,
  "bin": {
    "severally-mcp": "bin/severally-mcp.mjs",
    "severally-install": "scripts/install.mjs"
  },
  "files": [
    "bin",
    "src",
    "plugins",
    "scripts",
    ".agents",
    "README.md",
    "README.ja.md",
    "CONFIG.md",
    "config.example.json",
    "CODE_OF_CONDUCT.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "live-check": "node scripts/live-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install-all": "node scripts/install.mjs",
    "live-mcp-check": "node scripts/live-mcp-check.mjs",
    "build": "node scripts/build.mjs",
    "init-config": "node scripts/init-config.mjs",
    "prepack": "node scripts/build.mjs",
    "format": "prettier --write \"**/*.mjs\"",
    "format:check": "prettier --check \"**/*.mjs\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "cross-spawn": "^7.0.6",
    "which": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.18.6",
    "@types/which": "2.0.2",
    "esbuild": "^0.28.2",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
