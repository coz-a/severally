// Full key reference, and what each one does: CONFIG.md
// This file exercises every per-target key at least once; you do not need to
// set them all -- most operators need only one or two overrides.
{
  "targets": {
    "codex": { "enabled": false, "note": "rate-limited until 15:00" },
    "claude-code": {
      "bin": "/opt/claude/bin/claude",
      "default_model": "claude-fable-5-1",
      "allowed_models": ["claude-fable-5-1", "claude-opus-5", "claude-sonnet-5"],
      "timeout_ms": 900000
    },
    "antigravity": { "bin": "/opt/agy/bin/agy", "default_model": "gemini-3.1-pro-high" },
    "opencode": {
      "default_model": "zai-coding-plan/glm-5.3",
      "allowed_models": ["zai-coding-plan/glm-5.3", "zai-coding-plan/glm-5.3-flash"]
    }
  }
}
