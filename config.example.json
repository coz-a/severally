// Full key reference, and what each one does: CONFIG.md
// This file exercises every clis and consultants key and some server keys; you do not need to
// set them all -- most operators need only one or two. The paths, models and notes are made up:
// replace them with your own.
{
  "server": { "max_rounds": 10, "timeout_ms": 900000 },
  "clis": {
    "codex": { "enabled": false, "note": "rate-limited until 15:00" },
    "claude-code": {
      "bin": "/opt/claude/bin/claude",
      "args": ["--disallowedTools", "WebFetch"],
      "env": { "HTTPS_PROXY": "http://proxy.internal:3128" }
    },
    "antigravity": { "bin": "/opt/agy/bin/agy" }
  },
  "consultants": {
    "opus": { "cli": "claude-code", "model": "claude-opus-5-5", "effort": "max", "max_budget_usd": 5, "timeout_ms": 900000 },
    "fable": { "cli": "claude-code", "model": "claude-fable-5-1" },
    "sol": { "cli": "codex", "model": "gpt-6.1-sol" },
    "gemini": { "cli": "antigravity", "model": "gemini-4-argon-high", "fallback_model": "gemini-3.8-flash-high" },
    "glm": { "cli": "opencode", "model": "zai-coding-plan/glm-5.3" },
    "deepseek": { "cli": "opencode", "model": "opencode/deepseek-v4.1-flash-free", "enabled": false, "note": "trial ended" },
    "nemotron": { "cli": "opencode", "model": "opencode/nemotron-3-ultra-free#", "vendor": "nvidia" }
  },
  "ranking": ["opus", "glm"]
}
